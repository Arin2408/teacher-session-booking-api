              "raw": "{\n  \"teacherId\": \"000000000000000000000000\",\n  \"startTime\": \"{{sessionDate}}T10:00:00.000Z\",\n  \"endTime\": \"{{sessionDate}}T11:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get Available Sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "available"
              ],
              "query": [
                {
                  "key": "dateTimestamp",
                  "value": "{{dateTimestamp}}"
                }
              ]
            },
            "description": "API 3 — Aggregation pipeline. dateTimestamp is a Unix timestamp (ms or seconds); the whole UTC day is matched."
          }
        },
        {
          "name": "Get Available Sessions - Missing Timestamp (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
